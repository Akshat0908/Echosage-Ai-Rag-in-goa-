# Required for real voice-to-text through Sarvam.
SARVAM_API_KEY=
# Optional; defaults to saaras:v3.
SARVAM_STT_MODEL=saaras:v3
# Optional label for benchmark/export reports; never expose this value to the browser.
RAG_INDEX_BUILD=hin-ben-tel-plus-english-validation-reservoir-2000
# Local Qdrant: docker compose up -d qdrant
QDRANT_URL=http://127.0.0.1:6333
QDRANT_COLLECTION=msmarco_xi_multilingual
# Set only after the local Qdrant service has been indexed.
RAG_VECTOR_BACKEND=qdrant
